# Copier ce fichier en .env puis adapter les valeurs : cp .env.example .env
# (.env est ignoré par Git)

# Utilisateur et base PostgreSQL (utilisés par db et api)
POSTGRES_USER=demo
POSTGRES_DB=demo

# Ports publiés sur l'hôte
API_PORT=8080
ADMINER_PORT=8081

# Le mot de passe de la base n'est PAS ici : il est dans secrets/db_password.txt (Docker Secrets)

# Images déployées (docker compose pull) : préfixe du registre et version (tag Git)
# En local, laisser TAG vide : les images sont construites avec "up --build" (tag "local")
IMAGE_PREFIX=ghcr.io/ynov-x-anthony/beddiaf_miloud_demo-api
#TAG=v1.5.0
