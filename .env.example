# Copier ce fichier en .env puis adapter les valeurs : cp .env.example .env
# (.env est ignoré par Git)

# Utilisateur et base PostgreSQL (utilisés par db et api)
POSTGRES_USER=demo
POSTGRES_DB=demo

# Ports publiés sur l'hôte
API_PORT=8080
ADMINER_PORT=8081

# Le mot de passe de la base n'est PAS ici : il est dans secrets/db_password.txt (Docker Secrets)
