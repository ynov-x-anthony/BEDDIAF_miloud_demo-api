# syntax=docker/dockerfile:1

# Base épinglée et récente (bumpée régulièrement pour suivre les correctifs de CVE)
ARG NODE_IMAGE=node:22.23.4-alpine3.24

# --- étape deps : installe uniquement les dépendances de prod ---------------
FROM ${NODE_IMAGE} AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# Le .npmrc (token registre privé) est monté en RAM le temps du RUN : jamais dans un layer
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc \
    npm ci --omit=dev

# --- étape runtime : minimale, non-root -------------------------------------
FROM ${NODE_IMAGE} AS runtime
# Correctifs OS de la base + retrait de npm/yarn/corepack, inutiles pour exécuter l'API
# (ils embarquent leurs propres dépendances, sources de CVE)
RUN apk upgrade --no-cache \
 && rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx \
           /usr/local/bin/corepack /opt/yarn* /usr/local/bin/yarn /usr/local/bin/yarnpkg
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node server.js db.js package.json ./
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
